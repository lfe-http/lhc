{erl_opts, [debug_info, {no_auto_import, [{get,1}]}]}.

{deps, [
  {lfe, "~> 2.2"},
  {gun, "~> 2.2"}
]}.

%% This override is only needed until the work from this ticket
%% is released in a new version of rebar3:
%% * https://github.com/erlang/rebar3/issues/2364
{overrides, [
    {override, gun, [{deps, [cowlib, ranch]}]}
]}.

{project_plugins, [
  {rebar3_lfe, "~> 0.5"}
]}.

{provider_hooks, [
  {pre, [
    {compile, {lfe, compile}},
    {ct, compile}
  ]}
]}.

{xref_checks, [
  undefined_function_calls, undefined_functions, locals_not_used,
  deprecated_function_calls, deprecated_functions
]}.

{dialyzer, [
  {warnings, [unknown]},
  {plt_extra_apps, [eunit]}
]}.

{ct_opts, [
  {dir, "_build/test/lib/lhc/ebin"}
]}.

{profiles, [
  {test, [
    {deps, [
      {proper, "~> 1.5"},
      {cowboy, "~> 2.14"},
      {jsx, "~> 3.1"}
    ]},
    {plugins, [
      {rebar3_proper, "~> 0.12"}
    ]},
    {erl_opts, [
      {src_dirs, ["src", "test"]}
    ]}
  ]}
]}.

{alias, [
  {coverage, [
    {proper, "-c"},
    {cover, "-v --min_coverage=0"}
  ]},
  {check, [
    compile,
    xref,
    %%dialyzer,
    ct,
    coverage
  ]}
]}.
